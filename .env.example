GROQ_API_KEY=your_groq_api_key_here
PORT=3000

# ── Enable Banking (enablebanking.com) ───────────────────────────────────────
ENABLEBANKING_ID=your_application_id
ENABLEBANKING_PEM=-----BEGIN PRIVATE KEY-----...-----END PRIVATE KEY-----
ENABLEBANKING_REDIRECT_URL=http://localhost:5173/bank/callback
BANK_STATE_SECRET=generate_with_openssl_rand_hex_32

# ── Firebase Admin (server-side access to bank connection storage) ──────────
FIREBASE_SERVICE_ACCOUNT_BASE64=base64_encoded_service_account_json
